# Maintainer: apiplant <releases@apiplant.com>
#
# Built by the release workflow, which fills in the version and checksum and
# publishes the resulting package to apiplant.github.io/pacman. It is not an
# AUR manifest: it installs the binaries the release already built.
pkgname=sam-rs-cuda
pkgver=@VERSION@
pkgrel=1
pkgdesc="Rust (candle) inference for Segment Anything models (SAM, SAM 2, SAM 3) (CUDA build)"
arch=('x86_64')
url="https://github.com/apiplant/sam-rs"
license=('Apache-2.0')
depends=('nvidia-utils' 'cuda')
provides=('sam-rs')
conflicts=('sam-rs')
# The release archive holding the binaries and the README. The workflow builds
# the package before the release exists and drops the archive next to this
# file, which makepkg picks up instead of downloading; the URL is what makes
# the PKGBUILD work on its own once the release is published.
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/@ARCHIVE_PREFIX@-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64_CUDA@')
# The release profile already strips symbols, and makepkg's strip pass
# would buy nothing.
options=('!strip' '!debug')

package() {
  local src="$srcdir/@ARCHIVE_PREFIX@-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 "$src/sam-rs" "$pkgdir/usr/bin/sam-rs"
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
